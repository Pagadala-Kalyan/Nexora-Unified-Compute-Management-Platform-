DATABASE_URL=sqlite:///./nexora.db
JWT_SECRET=replace-with-a-long-random-secret
PROVIDER_SHARED_TOKEN=replace-with-a-provider-shared-token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
# Local Docker demo only. For internet clients, use a public MediaMTX host and
# set both URLs to its externally reachable addresses (RTMPS/RTSPS in production).
MEDIAMTX_INGEST_URL=rtmp://127.0.0.1:1935
MEDIAMTX_PROVIDER_READ_URL=rtsp://127.0.0.1:8554
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
# For a remote browser, set allowed origins to the frontend origin(s) and
# additional hosts to the Docker host's browser-reachable LAN/public IP or DNS.
MEDIAMTX_WEBRTC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
MEDIA_SERVER_ALLOW_LOOPBACK=true
STREAM_INPUT_TIMEOUT_SECONDS=90
